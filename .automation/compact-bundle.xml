<file path=".github/workflows/windows-smoke-test.yml">
name: Windows desktop smoke test
on:
  workflow_dispatch:
  push:
    paths:
      - 'packages/desktop/**'
      - 'packages/cli/**'
      - 'packages/analysis/**'
      - 'packages/diagram-view/**'
      - '.github/workflows/windows-smoke-test.yml'
jobs:
  build-and-launch:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: npm install
      - run: npm run build --workspace=packages/analysis
      - run: npm run build --workspace=packages/llm
      - run: npm run build --workspace=packages/diagram-view
      - run: npm run build --workspace=packages/cli
      - run: npm run build --workspace=packages/desktop
      - name: Package for Windows
        working-directory: packages/desktop
        run: npx electron-builder --win --dir
      - name: Upload build for local testing
        uses: actions/upload-artifact@v4
        with:
          name: kratai-windows
          path: packages/desktop/dist/win-unpacked
          retention-days: 90
      - name: Launch kratai.exe and confirm it doesn't crash
        shell: pwsh
        working-directory: packages/desktop
        run: |
          $exe = Get-ChildItem -Path dist -Recurse -Filter "kratai.exe" | Select-Object -First 1
          if (-not $exe) { throw "kratai.exe not found under dist/ - packaging didn't produce the expected output" }
          $proc = Start-Process -FilePath $exe.FullName -PassThru
          Start-Sleep -Seconds 8
          if ($proc.HasExited) {
            throw "kratai.exe exited within 8s (code $($proc.ExitCode)) - treating this as a launch crash"
          }
          Write-Host "kratai.exe is still running after 8s (PID $($proc.Id)) - launch smoke test passed"
          Stop-Process -Id $proc.Id -Force
</file>

