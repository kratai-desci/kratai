{
  "name": "@kratai/mcp-server",
  "version": "1.0.0",
  "description": "Standalone MCP server exposing kratai architecture diagrams to AI agents.",
  "type": "module",
  "bin": {
    "kratai-mcp": "./out/server.mjs"
  },
  "files": [
    "out",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "build": "npm run typecheck && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "start": "node ./out/server.mjs"
  },
  "dependencies": {
    "@kratai/core": "*",
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "esbuild": "^0.24.0"
  }
}
