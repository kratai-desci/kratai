{
  "name": "@kratai/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop app - a native window around the same local view server `kratai view` already runs (@kratai/cli's runView), so it always reflects the Stack Layer + Class Diagram UI both share, not a separate renderer to keep in sync.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kratai-desci/kratai.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "build": "npm run typecheck && node esbuild.js && node copy-vendor.js",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@kratai/cli": "*"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "electron": "^33.2.0",
    "electron-builder": "24.13.3",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "com.kratai.desktop",
    "productName": "kratai",
    "electronVersion": "33.4.11",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "assets/icon.png"
    }
  }
}
