{
  "name": "@kratai/cli",
  "version": "0.1.0",
  "description": "Installable CLI - generates a self-contained static HTML architecture diagram from your codebase, no VS Code or backend needed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kratai-desci/kratai.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./out/lib/index.js",
  "types": "./out/lib/index.d.ts",
  "bin": {
    "kratai": "./out/cli.mjs"
  },
  "files": [
    "out",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "build": "npm run typecheck && node esbuild.js && node copy-vendor.js && tsc -p tsconfig.lib.json",
    "watch": "tsc -watch -p ./",
    "start": "node ./out/cli.mjs"
  },
  "dependencies": {
    "@kratai/analysis": "*",
    "@kratai/diagram-view": "*"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "esbuild": "^0.24.0"
  }
}
