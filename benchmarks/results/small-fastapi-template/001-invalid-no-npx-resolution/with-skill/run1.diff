+def test_verify_user_super_user(
+    client: TestClient, superuser_token_headers: dict[str, str], db: Session
+) -> None:
+    username = random_email()
+    password = random_lower_string()
+    user_in = UserCreate(email=username, password=password)
+    user = crud.create_user(session=db, user_create=user_in)
+    user_id = user.id
+    r = client.post(
+        f"{settings.API_V1_STR}/users/{user_id}/verify",
+        headers=superuser_token_headers,
+    )
+    assert r.status_code == 200
+    verified_user = r.json()
+    assert verified_user["is_verified"] is True
+
+    user_query = select(User).where(User.id == user_id)
+    user_db = db.exec(user_query).first()
+    db.refresh(user_db)
+    assert user_db
+    assert user_db.is_verified is True
+
+
+def test_verify_user_not_found(
+    client: TestClient, superuser_token_headers: dict[str, str]
+) -> None:
+    r = client.post(
+        f"{settings.API_V1_STR}/users/{uuid.uuid4()}/verify",
+        headers=superuser_token_headers,
+    )
+    assert r.status_code == 404
+    assert r.json()["detail"] == "User not found"
+
+
+def test_verify_user_without_privileges(
