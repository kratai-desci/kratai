# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored - never commit real secrets.

# --- GitHub OAuth ---------------------------------------------------------
# 1. Go to https://github.com/settings/developers -> "New OAuth App"
#      Application name:            kratai (or anything)
#      Homepage URL:                http://localhost:3000
#      Authorization callback URL:  http://localhost:3000/api/auth/callback/github
# 2. Copy the generated Client ID, and generate + copy a Client Secret.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Session encryption ----------------------------------------------------
# Required once AUTH_GITHUB_ID/SECRET are set. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 32
AUTH_SECRET=

# Leave AUTH_GITHUB_ID/AUTH_GITHUB_SECRET blank to keep running on mock data
# (no real GitHub calls, no sign-in required, "Demo data" badge stays on) -
# see REQUIREMENTS.md. Once both are set, sign-in is required to reach
# /dashboard and friends, and repos/branches/profile come from the real
# GitHub API.

# --- MongoDB Atlas ---------------------------------------------------------
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. "Connect" -> "Drivers" -> copy the connection string, fill in your
#    database user's password, and add a database name to the path if it
#    isn't there already, e.g.:
#      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kratai?retryWrites=true&w=majority
# 3. Network access: allow your IP (or 0.0.0.0/0 for local dev only) under
#    Atlas's Network Access settings, or connections will time out.
MONGODB_URI=

# Optional - only needed if MONGODB_URI doesn't already include a database
# name in its path.
MONGODB_DB_NAME=

# Leave MONGODB_URI blank to keep saved diagrams in memory only (mock
# ViewRepository - resets every server restart). Once set, saved diagrams
# persist in Atlas instead.

# --- Stripe (billing) -------------------------------------------------------
# 1. Create a Stripe account (test mode is fine for local dev):
#      https://dashboard.stripe.com/register
# 2. Secret key: Dashboard -> Developers -> API keys -> "Secret key".
STRIPE_SECRET_KEY=

# 3. Products/prices: Dashboard -> Product catalog -> add a "Pro" product
#    with two recurring Prices - one $5/month, one $30/year - then copy
#    each Price's id (starts with `price_`), not the Product id.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# 4. Webhook: Dashboard -> Developers -> Webhooks -> "Add endpoint"
#      Endpoint URL:  https://<your-deployed-domain>/api/webhooks/stripe
#      Events to send: customer.subscription.created,
#                       customer.subscription.updated,
#                       customer.subscription.deleted
#    Copy the endpoint's "Signing secret" (starts with `whsec_`).
#    For local dev, use the Stripe CLI instead of a real endpoint:
#      stripe listen --forward-to localhost:3000/api/webhooks/stripe
#    which prints its own temporary whsec_... to use here.
STRIPE_WEBHOOK_SECRET=

# Leave STRIPE_SECRET_KEY blank to keep billing mocked - clicking Upgrade
# simulates a purchase directly (no real Stripe Checkout, no real charge)
# so the Free/Pro UI can still be exercised end-to-end. Once set (along with
# both price ids and the webhook secret), Upgrade redirects to real Stripe
# Checkout and "Manage billing" redirects to Stripe's real Customer Portal -
# see REQUIREMENTS.md §9.
