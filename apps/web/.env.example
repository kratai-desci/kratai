# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored - never commit real secrets.

# --- GitHub OAuth ---------------------------------------------------------
# 1. Go to https://github.com/settings/developers -> "New OAuth App"
#      Application name:            kratai (or anything)
#      Homepage URL:                http://localhost:3000
#      Authorization callback URL:  http://localhost:3000/api/auth/callback/github
# 2. Copy the generated Client ID, and generate + copy a Client Secret.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Session encryption ----------------------------------------------------
# Required once AUTH_GITHUB_ID/SECRET are set. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 32
AUTH_SECRET=

# Leave AUTH_GITHUB_ID/AUTH_GITHUB_SECRET blank to keep running on mock data
# (no real GitHub calls, no sign-in required, "Demo data" badge stays on) -
# see REQUIREMENTS.md. Once both are set, sign-in is required to reach
# /dashboard and friends, and repos/branches/profile come from the real
# GitHub API.
